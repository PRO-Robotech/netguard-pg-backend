# Debug version of backend Dockerfile with Delve debugger
# Based on Dockerfile.backend but with debug capabilities

FROM golang:1.24-alpine AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

# Install git and delve
RUN apk add --no-cache git && \
    go install github.com/go-delve/delve/cmd/dlv@latest

# Copy dependencies first for caching
COPY go.mod go.sum ./
RUN go mod download

# Force rebuild timestamp
RUN echo "Debug build timestamp: $(date)" > /tmp/build_timestamp

# Copy source code
COPY cmd/ cmd/
COPY internal/ internal/
COPY pkg/ pkg/
COPY protos/ protos/
COPY config/ config/

# Build with debug symbols (NO optimization)
# -gcflags="all=-N -l" disables optimizations and inlining for better debugging
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -gcflags="all=-N -l" -o /app/server ./cmd/server

# Debug stage - use alpine for shell access
FROM alpine:latest

# Install ca-certificates and debugging tools
RUN apk add --no-cache ca-certificates bash netcat-openbsd

WORKDIR /app

# Copy delve from builder
COPY --from=builder /go/bin/dlv /usr/local/bin/dlv

# Copy binary with debug symbols
COPY --from=builder /app/server /app/server

# Expose application ports
EXPOSE 9090 8080
# Expose Delve debug port
EXPOSE 2345

# Default to running with Delve in headless mode
# Can be overridden in K8s deployment for normal execution
ENTRYPOINT ["/usr/local/bin/dlv"]
CMD ["--listen=:2345", "--headless=true", "--api-version=2", "--accept-multiclient", "--continue", "exec", "/app/server", "--"]
