# Debug version of goose Dockerfile with verbose logging
# Based on Dockerfile.goose but with enhanced logging for migration debugging

FROM golang:1.24-alpine AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

# Install updates and git for go get
RUN apk update --no-cache && \
    apk upgrade --no-cache && \
    apk add git bash

# Install goose v3.23.1 (latest version compatible with Go 1.22+)
RUN mkdir -p /app/bin && \
    GOBIN=/app/bin GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go install github.com/pressly/goose/v3/cmd/goose@v3.23.1

# Copy migrations from root migrations directory
COPY migrations/ /app/migrations/

# Create debug wrapper script
RUN cat > /app/debug-migrate.sh <<'EOF'
#!/bin/bash
set -e

echo "======================================"
echo "  Goose Migration Runner (Debug Mode)"
echo "======================================"
echo "Timestamp: $(date)"
echo "Working directory: $(pwd)"
echo "Migration files:"
ls -lah /app/migrations/ || echo "No migrations directory found"
echo ""
echo "Environment variables:"
echo "  DATABASE_CONNECTION_URL: ${DATABASE_CONNECTION_URL:0:50}..."
echo ""
echo "Running goose..."
echo "======================================"

# Run goose with verbose output
/app/bin/goose -v "$@"

EXIT_CODE=$?
echo ""
echo "======================================"
echo "Goose exit code: $EXIT_CODE"
if [ $EXIT_CODE -eq 0 ]; then
    echo "✅ Migrations completed successfully"
else
    echo "❌ Migrations failed"
fi
echo "======================================"

exit $EXIT_CODE
EOF

RUN chmod +x /app/debug-migrate.sh

# Second release stage - minimal image
FROM alpine:latest

# Install bash for debug script
RUN apk add --no-cache bash

WORKDIR /app/
COPY --from=builder /app/ /app/

# Default to debug wrapper
ENTRYPOINT ["/app/debug-migrate.sh"]
CMD ["-table=netguard_db_ver", "postgres", "$DATABASE_CONNECTION_URL", "up"]
