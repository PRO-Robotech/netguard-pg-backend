# Netguard PostgreSQL Backend - Environment Variables Example
# Copy this file to .env and configure for your environment

# ==================================================
# OutboxWorker Configuration
# ==================================================

# Enable/disable the OutboxWorker
OUTBOX_WORKER_ENABLED=true

# How often to poll the sync_outbox table for pending entries
OUTBOX_WORKER_POLL_INTERVAL=5s

# Maximum number of entries to process per batch
OUTBOX_WORKER_BATCH_SIZE=10

# Timeout for SGROUP sync operations
OUTBOX_SGROUP_TIMEOUT=4s

# ==================================================
# Retry Configuration
# ==================================================

# Maximum retry attempts for validation errors (invalid data)
# After these attempts, the entry is marked as permanently failed
OUTBOX_MAX_ATTEMPTS_VALIDATION=3

# Maximum retry attempts for temporary errors (SGROUP unavailable, etc.)
# These errors are expected to resolve after retries
OUTBOX_MAX_ATTEMPTS_TEMPORARY=20

# Maximum retry attempts for network errors
# Higher limit for transient network issues
OUTBOX_MAX_ATTEMPTS_NETWORK=100

# ==================================================
# Health Check Configuration
# ==================================================

# Interval for health check updates
OUTBOX_HEALTH_CHECK_INTERVAL=10s

# ==================================================
# Metrics Configuration
# ==================================================

# Enable/disable Prometheus metrics export
OUTBOX_METRICS_ENABLED=true
